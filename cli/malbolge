#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export MALBOLGE_ROOT="$(cd -- "$script_dir/.." && pwd)"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) binary="$script_dir/bin/malbolge.exe" ;;
  *) binary="$script_dir/bin/malbolge" ;;
esac
if [[ ! -x "$binary" ]]; then
  echo "malbolge: CLI binary is not built. See cli/README.md." >&2
  exit 1
fi
exec "$binary" "$@"
