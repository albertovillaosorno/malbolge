#!/usr/bin/env bash
set -euo pipefail
# Resolve installed symlinks to the repository-owned Python compiler driver.
script="${BASH_SOURCE[0]}"
for ((depth = 0; depth < 32; depth++)); do
  [[ -L "$script" ]] || break
  parent="$(cd -P -- "$(dirname -- "$script")" && pwd)"
  link="$(readlink "$script")"
  if [[ "$link" = /* ]]; then
    script="$link"
  else
    script="$parent/$link"
  fi
done
if [[ -L "$script" ]]; then
  echo 'c2malbolge: too many symbolic links in command path' >&2
  exit 1
fi
script_dir="$(cd -P -- "$(dirname -- "$script")" && pwd)"
if ! command -v python3.14 >/dev/null 2>&1; then
  echo 'c2malbolge: Python 3.14 is required to run the compiler driver' >&2
  exit 1
fi
exec python3.14 -B "$script_dir/c2malbolge.py" "$@"
