#!/usr/bin/env bash
set -euo pipefail
# Follow installation symlinks before locating the adjacent VM binary.
script="${BASH_SOURCE[0]}"
for ((depth = 0; depth < 32; depth++)); do
  [[ -L "$script" ]] || break
  parent="$(cd -P -- "$(dirname -- "$script")" && pwd)"
  link="$(readlink "$script")"
  if [[ "$link" = /* ]]; then
    script="$link"
  else
    script="$parent/$link"
  fi
done
if [[ -L "$script" ]]; then
  echo 'malbolge: too many symbolic links in command path' >&2
  exit 1
fi
script_dir="$(cd -P -- "$(dirname -- "$script")" && pwd)"
MALBOLGE_ROOT="$(cd -- "$script_dir/../../../../.." && pwd)"
export MALBOLGE_ROOT
# The Unix install points to a separately built release VM. A repository
# compiler session can opt into the matching *already built* debug VM instead,
# without trusting an old release executable or silently rebuilding anything.
if [[ "${1:-}" == "--repository-tools" ]]; then
  shift
  binary="$MALBOLGE_ROOT/.cache/rust/target/debug/malbolge"
  if [[ ! -x "$binary" ]]; then
    echo 'malbolge: repository VM binary is not built; run cargo build --bin malbolge' >&2
    exit 1
  fi
  exec "$binary" "$@"
fi
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) binary="$script_dir/bin/malbolge.exe" ;;
  *) binary="$script_dir/bin/malbolge" ;;
esac
if [[ ! -x "$binary" ]]; then
  # jig-ignore-next-line: indivisible reviewed identifier
  echo "malbolge: CLI binary is not built. See src/interface/command-line/README.md." >&2
  exit 1
fi
exec "$binary" "$@"
